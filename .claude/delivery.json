{
  "securityPaths": [
    ".claude/**",
    ".claude-plugin/**",
    ".github/workflows/**",
    "claude/plugins/*/.claude-plugin/**",
    "claude/plugins/**/hooks/**",
    "claude/plugins/delivery/skills/delivery-lifecycle/scripts/**"
  ],
  "autonomy": {
    "push": [
      "feature/*",
      "feat/*",
      "fix/*",
      "chore/*",
      "docs/*",
      "refactor/*",
      "test/*",
      "claude/*"
    ],
    "openPr": true,
    "autoFix": true,
    "cleanupMerged": true,
    "merge": {
      "low": "green",
      "medium": "ask"
    }
  }
}
