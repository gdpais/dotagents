{
  "model": "opus",
  "skillOverrides": {
    "anthropic-skills:chrome-browser": "off",
    "anthropic-skills:deep-research": "off",
    "anthropic-skills:docx": "off",
    "anthropic-skills:google-workspace": "off",
    "anthropic-skills:import-memory": "off",
    "anthropic-skills:morning": "off",
    "anthropic-skills:pdf": "off",
    "anthropic-skills:pptx": "off",
    "anthropic-skills:skill-creator": "off",
    "anthropic-skills:xlsx": "off"
  },
  "enableWorkflows": true,
  "enabledPlugins": {
    "session-report@claude-plugins-official": true,
    "project-artifact@claude-plugins-official": true,
    "delivery@dotagents": true,
    "replay-theater@dotagents": true,
    "blast-radius@dotagents": true,
    "sre@dotagents": true
  },
  "extraKnownMarketplaces": {
    "dotagents": {
      "source": {
        "source": "github",
        "repo": "gdpais/dotagents"
      }
    }
  },
  "outputStyle": "Concise",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "theme": "dark",
  "switchModelsOnFlag": false,
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": true
}
